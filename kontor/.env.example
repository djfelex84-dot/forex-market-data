# Administrator created on the first start (you can change the password later in the app).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=
ADMIN_LANG=et
COMPANY_NAME=Minu OÜ

# Optional: shared key for invoice recognition. Each company can also set its own key in Settings.
ANTHROPIC_API_KEY=
# Model used for invoice recognition.
AI_MODEL=claude-opus-5

# Set to 1 if the app is served over https but the proxy does not send X-Forwarded-Proto.
COOKIE_SECURE=
